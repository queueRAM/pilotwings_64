e asm.arch=mips
e asm.bits=64
e cfg.bigendian=true

e io.va=true
e asm.emu=true

# define IO maps for kernel and app .text and .data sections
# om fd vaddr [size] [paddr] [rwx] [name]
om 3 0x80200050 0x50e30 0x001000 mrx kernel
om 3 0x802ca900 0x8c8f0 0x051e30 mrx app

